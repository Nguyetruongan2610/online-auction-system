<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane stylesheets="@login.css" prefWidth="1280.0" prefHeight="800.0"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.client.LoginController">
    <padding>
        <Insets top="40" right="60" bottom="40" left="60"/>
    </padding>

    <HBox alignment="CENTER" spacing="30.0" styleClass="glass-panel" maxWidth="1100.0" maxHeight="680.0">
        <VBox alignment="CENTER_LEFT" spacing="16.0" styleClass="login-section" HBox.hgrow="ALWAYS" prefWidth="480.0">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <ImageView fitHeight="48.0" fitWidth="48.0" preserveRatio="true">
                    <image>
                        <Image url="@images/gavel-emblem.png"/>
                    </image>
                </ImageView>
                <VBox>
                    <Label text="ROYAL AUCTION" styleClass="brand-title"/>
                    <Label text="PREMIUM ONLINE AUCTION HOUSE" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>

            <Label text="Welcome Back" styleClass="heading"/>
            <Label text="Sign in to join live luxury auctions and place your bids." styleClass="description" wrapText="true"/>

            <VBox spacing="8.0">
                <Label text="Email / Username" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="Enter your email or username" styleClass="input-field"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="input-field"/>
            </VBox>

            <Label fx:id="statusLabel" styleClass="status-label" wrapText="true"/>

            <Button text="Sign In to Auction" onAction="#handleLogin" styleClass="login-button"
                    maxWidth="Infinity" prefHeight="48.0" defaultButton="true"/>

            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Button text="Forgot password?" onAction="#handleForgotPassword" styleClass="text-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Create New Account" onAction="#handleCreateAccount" styleClass="register-button"/>
            </HBox>
        </VBox>

        <StackPane styleClass="art-section" HBox.hgrow="ALWAYS">
            <ImageView fitWidth="460.0" fitHeight="560.0" preserveRatio="true" styleClass="art-image">
                <image>
                    <Image url="@images/auction-art.png"/>
                </image>
            </ImageView>
        </StackPane>
    </HBox>
</StackPane>