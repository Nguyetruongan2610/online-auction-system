<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@login.css" prefWidth="1280.0" prefHeight="800.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.AuctionListController">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="glass-panel">
            <Label text="ROYAL AUCTION — SÀN ĐẤU GIÁ" styleClass="brand-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" text="Bidder" styleClass="field-label"/>
            <Button text="Đăng xuất" minWidth="120.0" onAction="#handleLogout" styleClass="register-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0" styleClass="glass-panel">
            <BorderPane.margin>
                <Insets top="20"/>
            </BorderPane.margin>
            <Label text="Các phiên đấu giá đang mở (Mock Data - Tuần 6)" styleClass="field-label"/>
            <ListView fx:id="auctionListView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>